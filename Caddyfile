# Caddy gets and renews the HTTPS certificate by itself. DOMAIN comes from .env.
{$DOMAIN} {
	encode zstd gzip

	# One JSON line per visit (address, page, status) -- rotated by Docker.
	log {
		output stdout
		format json
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy app:3000
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
