# Copy to ".env" on the server and fill in. NEVER commit the real .env.
# Make secrets with:  openssl rand -hex 32   (use letters/digits only for the two MySQL passwords)

# --- Your website ---
DOMAIN=yourschool.in
APP_URL=https://yourschool.in
AUTH_URL=https://yourschool.in

# --- Database (used by the bundled MySQL container) ---
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# --- Secrets ---
# AUTH_SECRET signs login sessions. DATA_ENCRYPTION_KEY (64 hex chars) encrypts
# Aadhaar numbers: BACK IT UP somewhere safe -- if it is lost, stored numbers
# cannot be read again.
AUTH_SECRET=
DATA_ENCRYPTION_KEY=

# --- Email (password setup / reset links) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Your School <you@example.com>"

# --- SMS (admin sign-in codes). "console" is refused in production. ---
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=
