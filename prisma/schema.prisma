generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  PRINCIPAL
  TEACHER
  STAFF
  STUDENT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  staff   Staff?
  student Student?
  posts   Post[]
  pages   Page[]
  media   Media[]
  feePayments FeePayment[]
  passwordSetupTokens PasswordSetupToken[]
  galleryImages GalleryImage[]
  loginChallenges LoginChallenge[]

  // Verified phone for SMS one-time codes. Required to sign in as ADMIN.
  twoFactorPhone String?

  @@index([role])
}

// Who changed what. One row per create/update/delete made by a signed-in
// person (see src/lib/audit.ts); bulk teacher edits such as marking a whole
// class are grouped into one row with a count. There is deliberately no
// foreign key to User: the history must outlive a deleted account, so the
// actor's name/email/role are copied in. `changes` is JSON; secrets are
// replaced by "[changed]" and never stored.
model AuditLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  actorId    String?
  actorName  String?
  actorEmail String?
  actorRole  String?
  action     String
  entity     String
  entityId   String?
  label      String?
  changes    String?  @db.LongText
  count      Int      @default(1)
  ip         String?

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([actorId, createdAt])
}

// Every password check, kept to throttle brute-force guessing. `identifier`
// is the lowercased email; password-reset requests use "reset:<email>" and
// "reset-ip:<ip>" so they never count toward a login lockout.
model LoginAttempt {
  id         String   @id @default(cuid())
  identifier String
  ip         String?
  success    Boolean
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@index([ip, createdAt])
}

// Second step of an admin sign-in: the password was correct and a one-time
// code was texted to the admin. `id` is a random secret held in an httpOnly
// cookie; `verifiedAt` is set once the right code is entered, and
// `consumedAt` once it has been exchanged for a real session.
model LoginChallenge {
  id         String    @id
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  otpHash    String
  expiresAt  DateTime
  attempts   Int       @default(0)
  sendCount  Int       @default(1)
  lastSentAt DateTime  @default(now())
  verifiedAt DateTime?
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// One-time link sent by email so a newly admitted student/staff member
// sets their own password, instead of the admin choosing it for them.
model PasswordSetupToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Masters (add/edit only, no delete) that back the Designation and
// Qualification dropdowns on the Staff form -- kept as plain string
// columns on Staff (not FKs) so onboarding never breaks if a master
// row is renamed later.
model PortalRole {
  id   String @id @default(cuid())
  name String @unique
}

model Qualification {
  id   String @id @default(cuid())
  name String @unique
}

// Profile for any non-student employee: teachers, principal, and
// non-teaching staff (peon, accountant, etc.). `designation` and
// `qualification` are plain strings, picked from the PortalRole and
// Qualification masters in the UI, so onboarding never breaks if a
// master row is renamed later; `role` on the linked User drives
// portal permissions.
model Staff {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  designation   String
  qualification String?
  education     String?
  // Encrypted at rest (AES-256-GCM, see src/lib/fieldCrypto.ts); `aadharHash`
  // is a keyed hash used only to enforce one-staff-per-number uniqueness.
  aadharNumber  String?
  aadharHash    String? @unique
  phone         String?
  address       String?

  subjects        Subject[]
  classes         Class[]
  attendanceTaken Attendance[] @relation("AttendanceMarkedBy")
  gradesGiven     Grade[]      @relation("GradeGivenBy")
  examMarksGiven  ExamMark[]   @relation("ExamMarkEnteredBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Reference data ("masters"): subjects, class sections, and academic years.
model Subject {
  id   String @id @default(cuid())
  name String @unique
  code String? @unique

  staff        Staff[]
  students     Student[]
  grades       Grade[]
  examSubjects ExamSubject[]
}

model Section {
  id   String @id @default(cuid())
  name String @unique

  classes Class[]
}

// Address masters (add/edit only, no delete): State -> District -> Pincode,
// used on the Student admission form as a cascading picker.
model State {
  id   String @id @default(cuid())
  name String @unique

  districts District[]
  students  Student[]
}

model District {
  id      String @id @default(cuid())
  name    String
  stateId String
  state   State  @relation(fields: [stateId], references: [id])

  pincodes Pincode[]
  students Student[]

  @@unique([name, stateId])
}

model Pincode {
  id         String   @id @default(cuid())
  code       String
  districtId String
  district   District @relation(fields: [districtId], references: [id])

  students Student[]

  @@unique([code, districtId])
}

model AcademicYear {
  id        String   @id @default(cuid())
  name      String   @unique
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  isCurrent Boolean  @default(false)

  classes Class[]
}

model Student {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  classId String?
  class   Class?  @relation(fields: [classId], references: [id])

  fatherName String?
  motherName String?
  gender     Gender?

  address    String? @db.Text
  stateId    String?
  state      State?    @relation(fields: [stateId], references: [id])
  districtId String?
  district   District? @relation(fields: [districtId], references: [id])
  pincodeId  String?
  pincode    Pincode?  @relation(fields: [pincodeId], references: [id])

  // Elective stream (Science/Arts/Commerce, etc.) -- independent of
  // class, since a class's section is fixed but its students can still
  // split across streams (typically senior grades).
  streamId String?
  stream   Stream? @relation(fields: [streamId], references: [id])

  subjects Subject[]

  attendance   Attendance[]
  grades       Grade[]
  feePayments  FeePayment[]
  examMarks    ExamMark[]

  @@index([classId])
  @@index([streamId])
  @@index([stateId])
  @@index([districtId])
  @@index([pincodeId])
}

model Class {
  id   String @id @default(cuid())
  name String

  teacherId String?
  teacher   Staff?  @relation(fields: [teacherId], references: [id])

  sectionId String?
  section   Section? @relation(fields: [sectionId], references: [id])

  // Every class belongs to exactly one academic session -- the same
  // class name can recur across years as separate records (each with
  // its own roster/attendance/exams/fees), which is what powers
  // student promotion between years.
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  students      Student[]
  attendance    Attendance[]
  feeStructures FeeStructure[]
  exams         Exam[]

  @@unique([name, academicYearId])
}

model Attendance {
  id     String   @id @default(cuid())
  date   DateTime @db.Date
  status String

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  classId String
  class   Class  @relation(fields: [classId], references: [id])

  // Null when an admin marked it directly (admins have no Staff profile).
  markedById String?
  markedBy   Staff?  @relation("AttendanceMarkedBy", fields: [markedById], references: [id])

  createdAt DateTime @default(now())

  @@unique([studentId, date])
  @@index([classId, date])
}

model Grade {
  id       String @id @default(cuid())
  score    Float
  maxScore Float
  term     String

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  givenById String
  givenBy   Staff  @relation("GradeGivenBy", fields: [givenById], references: [id])

  createdAt DateTime @default(now())

  @@index([studentId, term])
}

model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String   @db.LongText
  published Boolean  @default(false)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PostCategory {
  NEWS
  EVENT
  ANNOUNCEMENT
}

model Post {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  content     String       @db.LongText
  category    PostCategory
  published   Boolean      @default(false)
  publishedAt DateTime?

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  media Media[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, publishedAt])
}

model Media {
  id       String  @id @default(cuid())
  url      String
  filename String
  mimeType String

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  postId String?
  post   Post?   @relation(fields: [postId], references: [id])

  createdAt DateTime @default(now())
}

// Photos shown on the public Gallery page. `url` points at the already
// admin-cropped image under public/uploads/gallery -- cropping happens
// client-side before upload, so there is nothing left to process server-side.
model GalleryImage {
  id      String  @id @default(cuid())
  url     String
  caption String?
  order   Int     @default(0)

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())

  @@index([order])
}

// Stream master (Science, Arts, Commerce, etc.) -- standalone list,
// shown alongside Classes on the public Classes page.
model Stream {
  id   String @id @default(cuid())
  name String @unique

  students Student[]
}

// Inquiries submitted through the public contact form.
model ContactMessage {
  id      String @id @default(cuid())
  name    String
  email   String
  phone   String?
  message String @db.Text
  read    Boolean @default(false)

  createdAt DateTime @default(now())
}

model Holiday {
  id        String   @id @default(cuid())
  name      String
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  @@index([date])
}

// Single-row site-wide settings (id is always "site").
// Editable copy/images for the fixed public pages (home, about, contact).
// `data` is JSON text kept as LongText; missing fields fall back to the
// defaults in src/lib/pageContent.ts, so a row only stores what was edited.
model PageContent {
  key       String   @id
  data      String   @db.LongText
  updatedAt DateTime @updatedAt
}

model SiteSettings {
  id         String   @id @default("site")
  schoolName String   @default("School Portal")
  address    String?
  phone      String?
  email      String?
  logoUrl    String?
  updatedAt  DateTime @updatedAt
}

model FeeStructure {
  id      String @id @default(cuid())
  classId String
  class   Class  @relation(fields: [classId], references: [id])
  term    String
  amount  Float

  createdAt DateTime @default(now())

  @@unique([classId, term])
}

model FeePayment {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term      String
  amount    Float
  method    String?
  note      String?
  paidAt    DateTime @default(now())

  recordedById String
  recordedBy   User   @relation(fields: [recordedById], references: [id])

  @@index([studentId, term])
}

model Exam {
  id        String    @id @default(cuid())
  name      String
  term      String
  classId   String
  class     Class     @relation(fields: [classId], references: [id])
  examDate  DateTime? @db.Date
  published Boolean   @default(false)
  createdAt DateTime  @default(now())

  subjects ExamSubject[]

  @@index([classId, term])
}

model ExamSubject {
  id        String  @id @default(cuid())
  examId    String
  exam      Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])
  maxMarks  Float   @default(100)

  marks ExamMark[]

  @@unique([examId, subjectId])
}

model ExamMark {
  id            String      @id @default(cuid())
  examSubjectId String
  examSubject   ExamSubject @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  marksObtained Float

  enteredById String
  enteredBy   Staff  @relation("ExamMarkEnteredBy", fields: [enteredById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examSubjectId, studentId])
}

// Dynamic role-based access control: which admin sections each Role
// can reach, on top of the always-on ADMIN superuser access enforced
// in code. Lets an admin grant e.g. PRINCIPAL access to Fees without
// a code change.
model Permission {
  id    String @id @default(cuid())
  key   String @unique
  label String

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  role         Role
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
}
