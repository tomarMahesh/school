generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  PRINCIPAL
  TEACHER
  STAFF
  STUDENT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  staff   Staff?
  student Student?
  posts   Post[]
  pages   Page[]
  media   Media[]

  @@index([role])
}

// Profile for any non-student employee: teachers, principal, and
// non-teaching staff (peon, accountant, etc.). `designation` is the
// free-text job title so the admin can add new titles without a
// schema change; `role` on the linked User drives portal permissions.
model Staff {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  designation   String
  qualification String?
  education     String?
  aadharNumber  String? @unique
  phone         String?
  address       String?

  subjects        Subject[]
  classes         Class[]
  attendanceTaken Attendance[] @relation("AttendanceMarkedBy")
  gradesGiven     Grade[]      @relation("GradeGivenBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Reference data ("masters"): subjects, class sections, and academic years.
model Subject {
  id   String @id @default(cuid())
  name String @unique
  code String? @unique

  staff  Staff[]
  grades Grade[]
}

model Section {
  id   String @id @default(cuid())
  name String @unique

  classes Class[]
}

model AcademicYear {
  id        String   @id @default(cuid())
  name      String   @unique
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  isCurrent Boolean  @default(false)
}

model Student {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  classId String?
  class   Class?  @relation(fields: [classId], references: [id])

  attendance Attendance[]
  grades     Grade[]

  @@index([classId])
}

model Class {
  id   String @id @default(cuid())
  name String @unique

  teacherId String?
  teacher   Staff?  @relation(fields: [teacherId], references: [id])

  sectionId String?
  section   Section? @relation(fields: [sectionId], references: [id])

  students   Student[]
  attendance Attendance[]
}

model Attendance {
  id     String   @id @default(cuid())
  date   DateTime @db.Date
  status String

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  classId String
  class   Class  @relation(fields: [classId], references: [id])

  markedById String
  markedBy   Staff  @relation("AttendanceMarkedBy", fields: [markedById], references: [id])

  createdAt DateTime @default(now())

  @@unique([studentId, date])
  @@index([classId, date])
}

model Grade {
  id       String @id @default(cuid())
  score    Float
  maxScore Float
  term     String

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  givenById String
  givenBy   Staff  @relation("GradeGivenBy", fields: [givenById], references: [id])

  createdAt DateTime @default(now())

  @@index([studentId, term])
}

model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String   @db.LongText
  published Boolean  @default(false)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PostCategory {
  NEWS
  EVENT
  ANNOUNCEMENT
}

model Post {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  content     String       @db.LongText
  category    PostCategory
  published   Boolean      @default(false)
  publishedAt DateTime?

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  media Media[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, publishedAt])
}

model Media {
  id       String  @id @default(cuid())
  url      String
  filename String
  mimeType String

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  postId String?
  post   Post?   @relation(fields: [postId], references: [id])

  createdAt DateTime @default(now())
}

// Inquiries submitted through the public contact form.
model ContactMessage {
  id      String @id @default(cuid())
  name    String
  email   String
  phone   String?
  message String @db.Text
  read    Boolean @default(false)

  createdAt DateTime @default(now())
}
